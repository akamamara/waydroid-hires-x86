 .../default/primary/StreamPrimaryPulse.cpp    |  4 +-
 audio/aidl/default/pulse/Context.cpp          | 33 ++++++++++---
 audio/aidl/default/pulse/Context.h            |  6 +++
 audio/aidl/default/pulse/StreamPulse.cpp      | 49 ++++++++++++++++---
 5 files changed, 78 insertions(+), 17 deletions(-)

diff --git a/audio/aidl/default/include/core-impl/StreamPulse.h b/audio/aidl/default/include/core-impl/StreamPulse.h
index 077eae8..dd367f5 100644
--- a/audio/aidl/default/include/core-impl/StreamPulse.h
+++ b/audio/aidl/default/include/core-impl/StreamPulse.h
@@ -67,7 +67,10 @@ class StreamPulse : public StreamCommonImpl {
     ::android::sp<::android::MonoPipeReader> makeSource(::android::MonoPipe* pipe);
     void registerCallbacks();
 
+    static constexpr pa_usec_t kWriteStallTimeoutUs = 500 * PA_USEC_PER_MSEC;
+
     std::atomic<pa_usec_t> mLatency = 21000;
+    bool mWriteStalled = false;
 
     // Only 'libnbaio_mono' is vendor-accessible, thus no access to the multi-reader Pipe.
     ::android::sp<::android::MonoPipe> mRecordSink;
diff --git a/audio/aidl/default/primary/StreamPrimaryPulse.cpp b/audio/aidl/default/primary/StreamPrimaryPulse.cpp
index 883d429..14d68ea 100644
--- a/audio/aidl/default/primary/StreamPrimaryPulse.cpp
+++ b/audio/aidl/default/primary/StreamPrimaryPulse.cpp
@@ -49,7 +49,9 @@ StreamPrimaryPulse::StreamPrimaryPulse(StreamContext* context, const Metadata& m
 ::android::status_t StreamPrimaryPulse::flush() {
     RETURN_STATUS_IF_ERROR(StreamPulse::flush());
     // TODO(b/372951987): consider if this needs to be done from 'StreamInWorkerLogic::cycle'.
-    return mIsInput ? standby() : ::android::OK;
+    // A flushed output goes to IDLE, and the next burst makes it ACTIVE without a start
+    // command, so uncork here. Otherwise the stream stays corked after a seek (pause, flush).
+    return mIsInput ? standby() : start();
 }
 
 ::android::status_t StreamPrimaryPulse::start() {
diff --git a/audio/aidl/default/pulse/Context.cpp b/audio/aidl/default/pulse/Context.cpp
index ae9df10..ece1f03 100644
--- a/audio/aidl/default/pulse/Context.cpp
+++ b/audio/aidl/default/pulse/Context.cpp
@@ -78,12 +78,10 @@ Context::Context()
             }
 
             // Wait until context is ready
-            while (pa_context_state_t s = pa_context_get_state(mCtx.get())) {
-                if (!PA_CONTEXT_IS_GOOD(s) || s == PA_CONTEXT_READY) {
-                    break;
-                }
-                pa_threaded_mainloop_wait(mMainloop.get());
-            }
+            waitUntil(pa_rtclock_now() + kOperationTimeoutUs, [&]() {
+                const pa_context_state_t s = pa_context_get_state(mCtx.get());
+                return !PA_CONTEXT_IS_GOOD(s) || s == PA_CONTEXT_READY;
+            });
         });
     });
 
@@ -109,6 +107,25 @@ const char* Context::getLastError() {
     return pa_strerror(pa_context_errno(mCtx.get()));
 }
 
+bool Context::waitUntil(pa_usec_t deadline, const std::function<bool()>& done) {
+    // pa_threaded_mainloop has no timed wait, so a one-shot timer wakes the wait at the deadline.
+    pa_time_event* timer = nullptr;
+    bool result;
+    while (!(result = done()) && pa_rtclock_now() < deadline) {
+        if (timer == nullptr) {
+            timer = pa_context_rttime_new(mCtx.get(), deadline,
+                    [](pa_mainloop_api*, pa_time_event*, const struct timeval*, void* userdata) {
+                        pa_threaded_mainloop_signal(
+                                reinterpret_cast<pa_threaded_mainloop*>(userdata), 0);
+                    }, mMainloop.get());
+            if (timer == nullptr) break;
+        }
+        pa_threaded_mainloop_wait(mMainloop.get());
+    }
+    if (timer != nullptr) pa_threaded_mainloop_get_api(mMainloop.get())->time_free(timer);
+    return result;
+}
+
 bool Context::waitForOperation(const std::function<pa_operation*(pa_context_success_cb_t, std::promise<bool>*)>& lambda) {
     std::promise<bool> promise;
     std::future<bool> future = promise.get_future();
@@ -123,7 +140,7 @@ bool Context::waitForOperation(const std::function<pa_operation*(pa_context_succ
     if (op == nullptr) return false;
 
     // Timeout for all operations
-    std::future_status status = future.wait_for(std::chrono::seconds(5));
+    std::future_status status = future.wait_for(std::chrono::microseconds(kOperationTimeoutUs));
     withLock([&]() {
         if (status == std::future_status::timeout) pa_operation_cancel(op);
         pa_operation_unref(op);
@@ -145,7 +162,7 @@ bool Context::waitForStreamOperation(const std::function<pa_operation*(pa_stream
     if (op == nullptr) return false;
 
     // Timeout for all operations
-    std::future_status status = future.wait_for(std::chrono::seconds(5));
+    std::future_status status = future.wait_for(std::chrono::microseconds(kOperationTimeoutUs));
     withLock([&]() {
         if (status == std::future_status::timeout) pa_operation_cancel(op);
         pa_operation_unref(op);
diff --git a/audio/aidl/default/pulse/Context.h b/audio/aidl/default/pulse/Context.h
index d52c4d3..05160c0 100644
--- a/audio/aidl/default/pulse/Context.h
+++ b/audio/aidl/default/pulse/Context.h
@@ -55,11 +55,17 @@ class Context {
     Context();
 
   public:
+    // Kept under the 3 s audioserver watchdog, since these waits run inside binder calls.
+    static constexpr pa_usec_t kOperationTimeoutUs = 2 * PA_USEC_PER_SEC;
+
     std::unique_ptr<pa_threaded_mainloop, MainloopDeleter> mMainloop;
     std::unique_ptr<pa_context, ContextDeleter> mCtx;
 
     ::android::status_t init();
     const char* getLastError();
+    // Waits on the mainloop until done() is true or the pa_rtclock_now() deadline passes.
+    // Must be called with the mainloop lock held. Returns the last result of done().
+    bool waitUntil(pa_usec_t deadline, const std::function<bool()>& done);
     bool waitForOperation(const std::function<pa_operation*(pa_context_success_cb_t, std::promise<bool>*)>& lambda);
     bool waitForStreamOperation(const std::function<pa_operation*(pa_stream_success_cb_t, std::promise<bool>*)>& lambda);
     void withLock(const std::function<void()>& lambda);
diff --git a/audio/aidl/default/pulse/StreamPulse.cpp b/audio/aidl/default/pulse/StreamPulse.cpp
index 13e02e4..66ae575 100644
--- a/audio/aidl/default/pulse/StreamPulse.cpp
+++ b/audio/aidl/default/pulse/StreamPulse.cpp
@@ -138,10 +138,14 @@ StreamPulse::~StreamPulse() {
         }
 
         // Wait until context is ready
-        if (connectRet == 0) {
-            while (pa_stream_get_state(mPAStream) == PA_STREAM_CREATING) {
-                pa_threaded_mainloop_wait(mPACtx->mMainloop.get());
-            }
+        if (connectRet == 0 &&
+            !mPACtx->waitUntil(pa_rtclock_now() + pulse::Context::kOperationTimeoutUs, [&]() {
+                return pa_stream_get_state(mPAStream) != PA_STREAM_CREATING;
+            })) {
+            // The stream may still become ready after this object is gone, and the latency
+            // callback writes into it.
+            pa_stream_set_latency_update_callback(mPAStream, nullptr, nullptr);
+            pa_stream_disconnect(mPAStream);
         }
     });
 
@@ -254,15 +258,39 @@ StreamPulse::~StreamPulse() {
             if (remainingFrames != 0) usleep(1000);
         }
     } else {
+        // On a stall or a failed stream the rest of the buffer is dropped and reported as
+        // written: a short or failed write would keep AudioFlinger retrying under its locks.
         mPACtx->withLock([&, fname = __func__]() {
+            const pa_usec_t deadline = pa_rtclock_now() + kWriteStallTimeoutUs;
             size_t remainingBytes = bytesToTransfer;
             while (remainingBytes > 0) {
-                size_t writable;
-                while ((writable = pa_stream_writable_size(mPAStream)) == 0) {
-                    pa_threaded_mainloop_wait(mPACtx->mMainloop.get());
+                size_t writable = 0;
+                bool notReady = false;
+                const bool ready = mPACtx->waitUntil(deadline, [&]() {
+                    writable = pa_stream_writable_size(mPAStream);
+                    notReady = writable == static_cast<size_t>(-1);
+                    return notReady || writable > 0 || pa_stream_is_corked(mPAStream) == 1;
+                });
+
+                if (notReady) {
+                    LOG(ERROR) << fname << ": PulseAudio stream is not ready, dropping "
+                               << remainingBytes << " bytes: " << mPACtx->getLastError();
+                    return;
+                }
+                if (!ready) {
+                    if (!mWriteStalled) {
+                        LOG(WARNING) << fname << ": PulseAudio stream stalled for "
+                                     << kWriteStallTimeoutUs / PA_USEC_PER_MSEC
+                                     << " ms, dropping audio until it asks for data again";
+                        mWriteStalled = true;
+                    }
+                    return;
                 }
 
-                size_t bytesToWrite = std::min(writable, remainingBytes);
+                // Only a corked stream gets here with nothing writable. It asks for no more than
+                // one target latency of data, so the rest is sent as pre-roll for start.
+                const size_t bytesToWrite =
+                        writable == 0 ? remainingBytes : std::min(writable, remainingBytes);
                 if (pa_stream_write(mPAStream, bufferOffset, bytesToWrite, nullptr, 0, PA_SEEK_RELATIVE) < 0) {
                     LOG(ERROR) << fname << ": Failed to write into PulseAudio: " << mPACtx->getLastError();
                     return;
@@ -271,6 +299,11 @@ StreamPulse::~StreamPulse() {
                 bufferOffset += bytesToWrite;
                 remainingBytes -= bytesToWrite;
             }
+
+            if (mWriteStalled) {
+                LOG(INFO) << fname << ": PulseAudio stream recovered from a stall";
+                mWriteStalled = false;
+            }
         });
     }
 
